# Copy to .env and fill in. Paste values after "=" with no spaces or quotes.
# Run `npm run check` to verify every key without printing it.

# Optional: Pexels has paused new API keys. Leave blank; Pixabay covers stock footage.
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Optional: more stock video from Coverr (free key: coverr.co → Profile → API).
COVERR_API_KEY=
# Optional: YouTube Data API v3, to read public video stats and comments (free key:
# console.cloud.google.com → a project → enable "YouTube Data API v3" → Credentials → API key).
YOUTUBE_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ANTHROPIC_API_KEY=
NOTION_TOKEN=

# Paste the link (or ID) of your "Video Pipeline" Notion page, then run
# `npm run notion:setup`. It creates the Videos table and fills in the two IDs below.
NOTION_PARENT_PAGE_ID=
NOTION_DATABASE_ID=
NOTION_DATA_SOURCE_ID=
